---
const services = [
  {
    title: 'Tráfego Pago',
    desc: 'Venda mais anunciando no Google, Facebook, LinkedIn e outros canais digitais através da nossa gestão de tráfego pago. Conte com especialistas certificados para maximizar seu investimento em marketing digital.',
    link: 'Gestão de Tráfego Pago',
    href: '/servicos/trafego-pago/',
  },
  {
    title: 'Redes Sociais',
    desc: 'Construímos autoridade e comunidade para a sua marca com conteúdo estratégico, criação de posts e gestão de perfis. Social media que transforma seguidores em clientes.',
    link: 'Gestão de Redes Sociais',
    href: '/#contact',
  },
  {
    title: 'Sites / Lojas Virtuais',
    desc: 'Criamos sites institucionais e lojas virtuais (e-commerce) rápidos, responsivos e focados em conversão. A base digital que a sua marca precisa para vender mais.',
    link: 'Sites e E-commerce',
    href: '/#contact',
  },
  {
    title: 'SEO / GEO',
    desc: 'Posicionamos o seu negócio no topo do Google e nas respostas das IAs (GEO). Otimização técnica, conteúdo e autoridade para atrair tráfego orgânico qualificado de forma contínua.',
    link: 'SEO e GEO',
    href: '/#contact',
  },
  {
    title: 'CRM / Inbound',
    desc: 'Atraia, nutra e converta leads com funis de inbound marketing e automação de CRM. Do primeiro contato à venda, com processos e dados que escalam.',
    link: 'CRM e Inbound Marketing',
    href: '/#contact',
  },
  {
    title: 'Automação / IA',
    desc: 'Implementamos agentes de IA, chatbots e automações que otimizam o atendimento, qualificam leads e liberam o seu time para o que realmente importa.',
    link: 'Automação e Agentes de IA',
    href: '/#contact',
  },
];
---

<section id="services" class="bg-white py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div
      class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-deep px-6 py-12 md:px-12 md:py-16 lg:px-16"
    >
      <!-- brilho decorativo -->
      <div class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-brand/30 blur-3xl" aria-hidden="true"></div>

      <div class="relative grid grid-cols-1 gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <!-- Coluna esquerda: pergunta (fixa no scroll no desktop) -->
        <div class="lg:sticky lg:top-28 lg:self-start" data-animate>
          <div class="mb-5 flex items-center gap-3">
            <span class="h-px w-10 bg-blue-400"></span>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-blue-300">o que fazemos</span>
          </div>
          <h2 class="font-display text-3xl font-bold leading-tight tracking-tight text-white md:text-4xl">
            Quais serviços de marketing digital oferecemos?
          </h2>
        </div>

        <!-- Coluna direita: acordeão -->
        <div data-animate>
          {
            services.map((s) => (
              <details name="services-accordion" class="svc-item group border-b border-white/10">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 group-open:border-b group-open:border-white/15 [&::-webkit-details-marker]:hidden">
                  <span class="font-display text-2xl font-bold text-white md:text-3xl">{s.title}</span>
                  <span class="svc-arrow inline-flex shrink-0 text-white transition-transform duration-300">
                    <svg
                      class="h-6 w-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="4" y1="12" x2="20" y2="12" />
                      <polyline points="13 5 20 12 13 19" />
                    </svg>
                  </span>
                </summary>
                <div class="pt-7 pb-9">
                  <p class="max-w-xl leading-relaxed text-blue-100/80">{s.desc}</p>
                  <a
                    href={s.href}
                    class="mt-6 inline-block font-semibold text-white underline decoration-white/40 underline-offset-4 transition-colors hover:decoration-white"
                  >
                    {s.link}
                  </a>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Seta aponta para cima quando o item abre (via evento toggle — à prova de scoping/CSS)
  document.querySelectorAll<HTMLDetailsElement>('#services details').forEach((d) => {
    d.addEventListener('toggle', () => {
      const arrow = d.querySelector<HTMLElement>('.svc-arrow');
      if (arrow) arrow.style.transform = d.open ? 'rotate(-90deg)' : '';
    });
  });
</script>
