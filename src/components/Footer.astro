---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white pt-20 pb-10">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16 grid grid-cols-1 gap-12 md:grid-cols-4">
      <div class="md:col-span-2">
        <a href="/" class="mb-6 flex items-center" aria-label="Blue Digital Hub, ir para o início">
          <img src="/logo.svg" alt="Blue Digital Hub" width="1920" height="396" class="h-11 w-auto" />
        </a>
        <p class="mb-8 max-w-sm leading-relaxed text-slate-500">
          Agência de marketing estratégico em São Paulo. Unimos criatividade, dados e tecnologia para acelerar o
          crescimento do seu negócio.
        </p>
        <a
          href="https://www.instagram.com/bluedigital.hub/"
          target="_blank"
          rel="noopener"
          aria-label="Instagram da Blue Digital Hub"
          class="inline-flex rounded-full border border-slate-100 bg-slate-50 p-3 text-slate-400 transition-colors hover:border-blue-200 hover:bg-blue-50 hover:text-brand"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
          </svg>
        </a>
      </div>

      <nav aria-label="Serviços">
        <h4 class="mb-6 font-display text-lg font-bold text-deep">Serviços</h4>
        <ul class="space-y-4 text-slate-500">
          <li><a href="/servicos/branding-estrategico/" class="transition-colors hover:text-brand">Branding Estratégico</a></li>
          <li><a href="/servicos/trafego-pago/" class="transition-colors hover:text-brand">Gestão de Tráfego Pago</a></li>
          <li><a href="/#services" class="transition-colors hover:text-brand">Inbound Marketing</a></li>
          <li><a href="/#services" class="transition-colors hover:text-brand">Web & E-commerce</a></li>
        </ul>
      </nav>

      <nav aria-label="Empresa">
        <h4 class="mb-6 font-display text-lg font-bold text-deep">Empresa</h4>
        <ul class="space-y-4 text-slate-500">
          <li><a href="/#manifesto" class="transition-colors hover:text-brand">Sobre nós</a></li>
          <li><a href="/#portfolio" class="transition-colors hover:text-brand">Portfólio</a></li>
          <li><a href="/#contact" class="transition-colors hover:text-brand">Contato</a></li>
          <li>
            <a href="https://www.instagram.com/bluedigital.hub/" target="_blank" rel="noopener" class="transition-colors hover:text-brand">Instagram</a>
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-slate-100 pt-8 text-sm text-slate-400 md:flex-row md:gap-0"
    >
      <img src="/logo.svg" alt="Blue Digital Hub" width="1920" height="396" class="h-5 w-auto opacity-70" />
      <p>&copy; {year} Blue Digital Hub. Todos os direitos reservados.</p>
      <p>Feito com <span class="mx-1">💙</span> em São Paulo</p>
    </div>
  </div>
</footer>
