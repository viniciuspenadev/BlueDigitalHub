---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Faq from '../../components/Faq.astro';

// SEO: keyword principal "branding estratégico".
// Secundárias: agência de branding, identidade visual, posicionamento de marca, naming.
const title = 'Branding Estratégico em São Paulo | Blue Digital Hub';
const description =
  'Agência de branding estratégico em São Paulo. Posicionamento, naming, identidade visual e manual de marca para sua empresa. Peça um diagnóstico gratuito.';

const url = 'https://bluedigitalhub.com.br/servicos/branding-estrategico/';

const challenges = [
  'Sua marca se parece com a de todo concorrente do setor',
  'O cliente não entende em dois segundos o que você faz',
  'Cada material sai com uma cara diferente',
  'A negociação sempre trava no preço, nunca no valor',
  'A identidade envelheceu e não representa o negócio de hoje',
];

const offer = [
  {
    title: 'Estratégia',
    desc: 'Começamos pela pesquisa: mercado, concorrência, público e aquilo que o seu negócio faz melhor que os outros. Dali sai o posicionamento, a promessa central e o território que a marca vai ocupar na cabeça do cliente.',
  },
  {
    title: 'Identidade',
    desc: 'Traduzimos a estratégia em forma e palavra. Logotipo, paleta, tipografia e grafismos, junto do tom de voz que define como a marca fala no site, no anúncio e na resposta de um comentário.',
  },
  {
    title: 'Ativação',
    desc: 'Marca só existe quando aparece. Levamos a identidade nova para o site, as redes, as campanhas e os materiais do dia a dia, com um manual que mantém tudo alinhado mesmo quando outra equipe assume.',
  },
];

const deliverables = [
  {
    title: 'Diagnóstico e posicionamento',
    desc: 'Imersão no negócio, análise de concorrência e definição do território de marca: onde você compete e por que vence.',
  },
  {
    title: 'Naming e arquitetura de marca',
    desc: 'Criação ou refinamento de nomes, submarcas e a estrutura que organiza todo o seu portfólio de produtos.',
  },
  {
    title: 'Identidade visual',
    desc: 'Logotipo, paleta, tipografia, grafismos e sistema visual completo, entregues prontos para qualquer aplicação.',
  },
  {
    title: 'Tom de voz e identidade verbal',
    desc: 'Como sua marca fala, escreve e se posiciona, do slogan até a resposta de uma dúvida no Instagram.',
  },
  {
    title: 'Manual de marca',
    desc: 'Brand guidelines em PDF para garantir consistência entre time interno, agências e fornecedores.',
  },
  {
    title: 'Ativação nos canais',
    desc: 'Aplicação da nova identidade no site, nas redes sociais, nas campanhas e nos pontos de contato com o cliente.',
  },
];

const process = [
  {
    n: '01',
    title: 'Descoberta',
    time: '1 a 2 semanas',
    desc: 'Entrevistas com sócios e time, workshop de marca e pesquisa de concorrência para entender onde você está.',
  },
  {
    n: '02',
    title: 'Estratégia',
    time: '2 semanas',
    desc: 'Definição de propósito, posicionamento, público e a promessa central que a marca vai sustentar.',
  },
  {
    n: '03',
    title: 'Criação',
    time: '3 a 4 semanas',
    desc: 'Desenvolvimento da identidade visual e verbal, testada em aplicações reais antes da aprovação.',
  },
  {
    n: '04',
    title: 'Entrega e ativação',
    time: '1 semana',
    desc: 'Manual de marca, arquivos finais em todos os formatos e implementação nos canais do negócio.',
  },
];

const faqItems = [
  {
    q: 'O que é branding estratégico?',
    a: 'Branding estratégico é o processo de definir o posicionamento, o propósito e a personalidade de uma marca antes de desenhar qualquer logotipo. Envolve pesquisa de mercado, análise de concorrência, definição de público, construção da identidade visual e verbal, e as diretrizes que mantêm tudo consistente em cada ponto de contato com o cliente.',
  },
  {
    q: 'Qual a diferença entre branding e identidade visual?',
    a: 'Identidade visual é a parte que se vê: logotipo, cores, tipografia e grafismos. Branding é o conjunto maior, que inclui posicionamento, promessa, tom de voz e a percepção que as pessoas têm da empresa. A identidade visual é a consequência de um branding bem definido, nunca o ponto de partida.',
  },
  {
    q: 'Quanto tempo leva um projeto de branding?',
    a: 'Um projeto completo de branding estratégico leva de 4 a 10 semanas, divididas entre descoberta, estratégia, criação e entrega do manual de marca. Reposicionamento de empresas maiores, com mais produtos e mais gente envolvida na aprovação, costuma passar desse prazo.',
  },
  {
    q: 'Quanto custa um projeto de branding?',
    a: 'O valor é definido pelo escopo: se envolve naming, quantas submarcas existem, o volume de aplicações e o tamanho da pesquisa. Trabalhamos com projeto fechado, com escopo e prazo definidos em proposta, depois de uma conversa de diagnóstico gratuita.',
  },
  {
    q: 'Vocês fazem branding para empresas de qualquer segmento?',
    a: 'Sim. Já desenvolvemos marcas para produtos SaaS, escola particular, distribuidora de alimentos, academia e operação de logística internacional. O método se mantém, o que muda é a pesquisa e o território de marca de cada mercado.',
  },
  {
    q: 'Já tenho uma marca conhecida. Vale a pena fazer rebranding?',
    a: 'Vale quando a identidade atual não representa mais o que a empresa virou, ou quando ela atrapalha a entrada em um público novo. O rebranding parte do que já existe: avaliamos o que tem valor acumulado e deve ser preservado, e o que precisa evoluir, para modernizar sem jogar fora o reconhecimento conquistado.',
  },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Branding Estratégico',
    serviceType: 'Branding, posicionamento e identidade de marca',
    provider: { '@id': 'https://bluedigitalhub.com.br/#agencia' },
    areaServed: { '@type': 'Country', name: 'Brasil' },
    description,
    url,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Entregas de branding',
      itemListElement: deliverables.map((d) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: d.title, description: d.desc },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://bluedigitalhub.com.br/' },
      { '@type': 'ListItem', position: 2, name: 'Serviços', item: 'https://bluedigitalhub.com.br/#services' },
      { '@type': 'ListItem', position: 3, name: 'Branding Estratégico', item: url },
    ],
  },
];
---

<Base title={title} description={description} schemas={schemas}>
  <Header heroTheme="dark" />

  <main>
    <!-- HERO -->
    <section class="relative flex min-h-[76svh] items-center overflow-hidden bg-night pt-28 pb-20">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:5rem_5rem]"
        >
        </div>
        <div class="absolute -top-32 right-[-10%] h-[620px] w-[620px] rounded-full bg-brand/25 blur-3xl"></div>
        <div class="absolute bottom-[-35%] left-[-5%] h-[520px] w-[520px] rounded-full bg-deep/40 blur-3xl"></div>
      </div>

      <div class="relative mx-auto w-full max-w-7xl px-6">
        <nav class="mb-6 flex items-center gap-2 font-mono text-xs text-slate-400" aria-label="Trilha de navegação">
          <a href="/" class="transition-colors hover:text-blue-300">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/#services" class="transition-colors hover:text-blue-300">Serviços</a>
          <span aria-hidden="true">/</span>
          <span class="text-blue-300">Branding Estratégico</span>
        </nav>

        <h1 class="max-w-4xl font-display font-bold leading-[0.95] tracking-tighter text-white text-[clamp(2.6rem,6.5vw,5.5rem)]">
          Branding<br />Estratégico
        </h1>

        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-slate-300">
          Construímos marcas com posicionamento claro e identidade consistente, para o seu negócio ser escolhido pelo
          que representa e não pelo menor preço da tabela.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/#contact"
            class="group inline-flex items-center justify-center rounded-full bg-brand px-8 py-4 font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-xl hover:shadow-brand/30"
          >
            quero construir minha marca
            <svg class="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="12" x2="20" y2="12" /><polyline points="13 5 20 12 13 19" />
            </svg>
          </a>
          <a
            href="#entregas"
            class="inline-flex items-center justify-center rounded-full border border-white/20 px-8 py-4 font-medium text-white transition-colors hover:border-blue-400 hover:text-blue-300"
            >ver o que entregamos</a
          >
        </div>
      </div>
    </section>

    <!-- NÚMERO DE DESTAQUE (confirmar o total antes de publicar) -->
    <section class="bg-night pb-24">
      <div class="mx-auto max-w-7xl border-t border-white/10 px-6 pt-16">
        <p class="max-w-4xl font-display text-3xl font-bold leading-tight tracking-tight text-white md:text-5xl">
          Mais de <span class="bg-gradient-to-r from-blue-400 to-sky-300 bg-clip-text text-transparent">40 marcas</span>
          construídas e reposicionadas
        </p>
        <p class="mt-6 max-w-2xl leading-relaxed text-slate-400">
          Já trabalhamos identidade de marca para SaaS, escola particular, distribuidora de alimentos, academia e
          operação de logística internacional. Cada mercado pede um território diferente.
        </p>
      </div>
    </section>

    <!-- DEFINIÇÃO + DESAFIOS (bloco pensado para citação em IA) -->
    <section class="bg-white py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
        <div class="md:sticky md:top-28 md:self-start">
          <div class="mb-4 flex items-center gap-3">
            <span class="h-px w-10 bg-brand"></span>
            <span class="font-mono text-xs uppercase tracking-[0.25em] text-brand">o que é</span>
          </div>
          <h2 class="font-display text-3xl font-bold leading-tight tracking-tight text-deep md:text-4xl">
            O que é branding estratégico?
          </h2>
        </div>

        <div>
          <div class="space-y-5 text-lg leading-relaxed text-slate-600">
            <p>
              Branding estratégico é o processo de definir o posicionamento, o propósito e a personalidade de uma marca
              antes de desenhar qualquer logotipo. Envolve pesquisa de mercado, análise de concorrência, definição de
              público, construção da identidade visual e verbal, e as diretrizes que mantêm tudo consistente.
            </p>
            <p>
              A confusão mais comum é achar que branding é o logotipo. O logotipo é a assinatura. Branding é a
              reputação que essa assinatura carrega, construída pelo que você promete, entrega e comunica ao longo do
              tempo.
            </p>
            <p class="text-base">
              Marca definida também deixa a mídia mais barata. Quando o público já reconhece e confia, o anúncio
              precisa trabalhar menos para convencer, e isso aparece direto no custo por lead da
              <a href="/servicos/trafego-pago/" class="font-semibold text-brand underline decoration-brand/30 underline-offset-4 transition-colors hover:decoration-brand">gestão de tráfego pago</a>.
            </p>
          </div>

          <h3 class="mt-14 font-display text-2xl font-bold tracking-tight text-deep">Você enfrenta esses desafios?</h3>
          <ul class="mt-6 space-y-4">
            {
              challenges.map((c) => (
                <li class="flex items-start gap-4">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="9 11 12 14 22 4" />
                    </svg>
                  </span>
                  <span class="text-lg text-slate-700">{c}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- O QUE OFERECEMOS -->
    <section class="bg-slate-50/70 py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
        <h2 class="font-display text-3xl font-bold leading-tight tracking-tight text-deep md:sticky md:top-28 md:self-start md:text-4xl">
          O que oferecemos?
        </h2>
        <div class="space-y-12">
          {
            offer.map((o) => (
              <div>
                <h3 class="font-display text-2xl font-bold text-deep">{o.title}</h3>
                <p class="mt-3 max-w-xl leading-relaxed text-slate-600">{o.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ENTREGAS -->
    <section id="entregas" class="bg-night py-24">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="max-w-2xl font-display text-3xl font-bold leading-tight tracking-tight text-white md:text-4xl">
          O que está <span class="bg-gradient-to-r from-blue-400 to-sky-300 bg-clip-text text-transparent">incluído</span>
          no projeto
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-slate-400">
          Tudo o que sai do projeto, pronto para usar no dia seguinte à entrega.
        </p>

        <div class="mt-14 grid gap-x-16 gap-y-10 border-t border-white/10 pt-12 md:grid-cols-2">
          {
            deliverables.map((d) => (
              <div>
                <h3 class="font-display text-lg font-bold text-white">{d.title}</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-slate-400">{d.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PROCESSO -->
    <section class="bg-white py-24">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="max-w-2xl font-display text-3xl font-bold leading-tight tracking-tight text-deep md:text-4xl">
          Como funciona, da primeira reunião à entrega
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-slate-600">
          Projeto completo em 4 a 10 semanas, com aprovação sua ao fim de cada etapa.
        </p>

        <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {
            process.map((p) => (
              <div class="border-t-2 border-slate-100 pt-6">
                <div class="flex items-baseline gap-3">
                  <span class="font-display text-4xl font-bold text-brand/20">{p.n}</span>
                  <span class="font-mono text-xs tracking-wide text-brand">{p.time}</span>
                </div>
                <h3 class="mt-3 font-display text-xl font-bold text-deep">{p.title}</h3>
                <p class="mt-2 leading-relaxed text-slate-500">{p.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CASES -->
    <section class="bg-slate-50/70 py-24">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="max-w-2xl font-display text-3xl font-bold leading-tight tracking-tight text-deep md:text-4xl">
          Marcas que já passaram por aqui
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-slate-600">
          Do sistema de gestão escolar BluEduca ao Colégio Lumira, cada projeto começou pela mesma pergunta: o que essa
          marca precisa significar para o cliente dela.
        </p>
        <a
          href="/#portfolio"
          class="group mt-8 inline-flex items-center gap-2 font-semibold text-brand transition-colors hover:text-deep"
        >
          ver cases de sucesso
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="12" x2="20" y2="12" /><polyline points="13 5 20 12 13 19" />
          </svg>
        </a>
      </div>
    </section>

    <!-- FAIXA CTA -->
    <section class="bg-brand py-16">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-6 md:flex-row md:items-center">
        <p class="font-display text-3xl font-bold leading-tight text-white md:text-4xl">
          Dê o primeiro passo.<br />Vamos juntos.
        </p>
        <a
          href="/#contact"
          class="inline-flex shrink-0 items-center justify-center rounded-full bg-white px-8 py-4 text-sm font-bold tracking-wide text-deep uppercase transition-transform hover:-translate-y-0.5"
        >
          fale com um especialista
        </a>
      </div>
    </section>

    <Faq titlePlain="dúvidas sobre" titleAccent="branding estratégico" items={faqItems} />

    <!-- CTA FINAL -->
    <section class="relative overflow-hidden bg-night py-24">
      <div class="pointer-events-none absolute top-0 left-1/3 h-72 w-72 rounded-full bg-brand/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight text-white md:text-5xl">
          Pronto para construir uma marca memorável?
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-300">
          Responda algumas perguntas e receba um diagnóstico gratuito, com o que encontramos na sua marca hoje e o
          próximo passo recomendado.
        </p>
        <a
          href="/#contact"
          class="mt-9 inline-flex items-center justify-center rounded-full bg-white px-8 py-4 font-bold text-deep transition-all hover:-translate-y-0.5 hover:shadow-xl"
        >
          começar diagnóstico
          <svg class="ml-2 h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="12" x2="20" y2="12" /><polyline points="13 5 20 12 13 19" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
